{
  "name": "melvo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Melvo application — web surface served by an Express routing layer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --experimental-strip-types src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}

# Where every primary CTA on the site points. Required for production and CI
# builds: an unset, empty or malformed value fails `next build` rather than
# shipping a dead link. Accepts an absolute http(s) URL or a root-relative path.
#
# Outside production/CI (local `next dev`), an unset value logs a warning and
# falls back to the documented safe destination "/contact", a route this site
# always serves.
NEXT_PUBLIC_PRIMARY_CTA_DESTINATION=https://app.melvo.dev/signup

# Optional. Where primary-CTA analytics events are POSTed.
# Defaults to this app's own collection route, /api/analytics.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.melvo.dev/collect
